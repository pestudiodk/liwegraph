{
  "kind": "liwegraph/v1",
  "data": {
    "groups": [
      {
        "id": "collaboration",
        "label": "Collaboration",
        "nodes": [
          "user",
          "agent"
        ],
        "groups": []
      },
      {
        "id": "processing",
        "label": "Agent-run tools",
        "nodes": [
          "validator",
          "materialiser",
          "renderer"
        ],
        "groups": []
      },
      {
        "id": "outputs",
        "label": "Outputs",
        "nodes": [
          "viewer",
          "svg"
        ],
        "groups": []
      }
    ],
    "nodes": [
      {
        "id": "user",
        "label": "User",
        "kind": "human",
        "content": {
          "$text": "Describes intent, inspects the rendered result, and asks for the next change."
        }
      },
      {
        "id": "agent",
        "label": "agent",
        "kind": "agent",
        "content": {
          "$text": "Changes the graph's data and appearance with the user. It leaves layout calculation to the materialiser."
        }
      },
      {
        "id": "graph",
        "label": "LIWE Graph",
        "kind": "artifact",
        "content": {
          "$text": "One document keeps data, layout, and appearance separate. The LLM authors data and appearance; layout is derived."
        }
      },
      {
        "id": "validator",
        "label": "Validator",
        "kind": "process",
        "content": {
          "$text": "Checks the graph's data and appearance, then reports diagnostics or accepts it for layout."
        }
      },
      {
        "id": "materialiser",
        "label": "Materialiser",
        "kind": "process",
        "content": {
          "$text": "Calculates deterministic node positions, group bounds, edge routes, and label boxes."
        }
      },
      {
        "id": "renderer",
        "label": "Renderer",
        "kind": "process",
        "content": {
          "$text": "Uses validated data, derived layout, and appearance to create the interactive and standalone SVG views."
        }
      },
      {
        "id": "viewer",
        "label": "LIWE Graph viewer",
        "kind": "view",
        "content": {
          "$text": "Displays the interactive graph so the user can inspect nodes, relationships, and selected content."
        }
      },
      {
        "id": "svg",
        "label": "Standalone SVG",
        "kind": "output",
        "content": {
          "$text": "A shareable SVG export with inline styles and an optional legend."
        }
      }
    ],
