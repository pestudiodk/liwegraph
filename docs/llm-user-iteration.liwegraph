        "index": 1,
        "kind": "inspect",
        "label": "15 · inspect viewer"
      },
      {
        "from": "user",
        "to": "svg",
        "index": 1,
        "kind": "inspect",
        "label": "16 · review export"
      },
      {
        "from": "user",
